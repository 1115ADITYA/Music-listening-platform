# Gmail SMTP setup: create a Google App Password for the Gmail account that sends support messages.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password

# Where you want contact-form messages delivered. This can be the same Gmail address as SMTP_USER.
CONTACT_TO_EMAIL=your-gmail-address@gmail.com

# Optional: set a verified sender address. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=your-gmail-address@gmail.com
